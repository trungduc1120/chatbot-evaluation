# ============================================================
# Mẫu biến môi trường cho chatbot-evaluation
# Copy file này thành .env rồi điền giá trị thật:
#   cp .env.example .env
# ============================================================

# OpenRouter (OpenAI-compatible). Lấy key tại https://openrouter.ai/keys
OPENROUTER_API_KEY=

# (Tuỳ chọn) Key dự phòng, dùng khi key chính bị rate-limit
OPENROUTER_API_KEY_2=

# Base URL cho API tương thích OpenAI (mặc định là OpenRouter)
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Model dùng làm "giám khảo" / chat completion
JUDGE_MODEL=google/gemini-2.5-flash
EVAL_MODEL=openai/gpt-4o

# (ragas) Model embedding chạy cục bộ bằng sentence-transformers (không gọi API)
EMBED_MODEL=

# (ragas) Số câu hỏi đảo ngược sinh ra để tính Answer Relevancy
N_REVERSE_QUESTIONS=
